FROM node:22-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM node:22-alpine AS runner

WORKDIR /app

# Serves the app and forwards /api to the backend (see frontend-server.mjs).
COPY frontend-server.mjs ./
COPY --from=builder /app/dist ./dist

ENV PORT=3001
ENV BACKEND_URL=http://backend:8080

EXPOSE 3001

USER node

CMD ["node", "frontend-server.mjs"]

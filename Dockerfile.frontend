FROM node:22-alpine AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
RUN npm run build

FROM node:22-alpine AS runner

RUN npm install -g serve@14.2.4

WORKDIR /app

# serve.json falls back to index.html for react-router routes, but never for
# /plugin/: the backend fetches the plugin template from there, and those
# files must be served as-is (or 404) rather than as the app.
COPY serve.json ./
COPY --from=builder /app/dist ./dist

EXPOSE 3001

CMD ["serve", "-c", "serve.json", "-l", "tcp://0.0.0.0:3001", "--no-clipboard"]
